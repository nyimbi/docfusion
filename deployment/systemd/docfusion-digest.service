[Unit]
Description=DocuFusion daily opportunity digest email
After=network.target docfusion-daily-crawl.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/docfusion
EnvironmentFile=/root/docfusion/.env
ExecStart=/root/docfusion/.venv/bin/python -m docfusion.workers.digest
StandardOutput=journal
StandardError=journal
TimeoutSec=900
