[Unit]
Description=DocuFusion daily opportunity crawl
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/docfusion
EnvironmentFile=/root/docfusion/.env
ExecStart=/root/docfusion/.venv/bin/python -m docfusion.workers.daily_crawl
StandardOutput=journal
StandardError=journal
TimeoutSec=3600
