# Production Environment Configuration
# Copy this file to .env and fill in ALL required values
# NEVER commit actual production secrets to version control

# =============================================================================
# Environment (MUST be production in production)
# =============================================================================
DEBUG=false
LOG_LEVEL=warning
ENVIRONMENT=production

# =============================================================================
# Authentication Secrets (ALL REQUIRED in production)
# =============================================================================
# JWT secret for authentication tokens - MUST be set in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Data encryption key for sensitive storage (optional but recommended)
ENCRYPTION_KEY=

# Require authentication for API access
REQUIRE_AUTH=true

# =============================================================================
# OAuth Provider Configuration
# =============================================================================
# Google OAuth - required if using Google authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth - required if using Microsoft authentication
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub OAuth - required if using GitHub authentication
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Infrastructure Services
# =============================================================================
# SearXNG Search Engine
SEARXNG_URL=http://84.247.181.100:8888

# Firecrawl Web Scraping
FIRECRAWL_URL=http://84.247.181.100:3002
FIRECRAWL_KEY=

# LiteLLM AI Gateway
LITELLM_URL=http://84.247.181.100:4000/v1
LITELLM_API_KEY=
LITELLM_KEY=
LLM_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-ada-002
LITELLM_TIMEOUT=120

# OpenAI API (for AI-driven scraping and LLM features)
OPENAI_API_KEY=

# =============================================================================
# Database Configuration (REQUIRED in production)
# =============================================================================
DATABASE_URL=
DATABASE_PASSWORD=

# Redis Configuration
REDIS_URL=
REDIS_PASSWORD=

# =============================================================================
# Email Notification Provider Configuration
# Use the PJS Stalwart mail server unless a deployment explicitly opts out.
# =============================================================================
# SMTP Configuration (PJS Stalwart mail server)
SMTP_HOST=mail.lindela.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# External email providers are intentionally unset; use Stalwart SMTP by default.
SENDGRID_API_KEY=

# AWS SES (alternative email provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Mailgun (alternative email provider)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Postmark (alternative email provider)
POSTMARK_API_KEY=

# =============================================================================
# SMS Notification Provider Configuration
# Choose ONE provider and configure its secrets
# =============================================================================
# Twilio SMS Provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Generic SMS Provider
SMS_API_KEY=
SMS_API_SECRET=

# =============================================================================
# Webhook Configuration
# =============================================================================
# Webhook authentication (for outgoing webhooks)
WEBHOOK_API_KEY=
WEBHOOK_API_SECRET=
WEBHOOK_BEARER_TOKEN=
WEBHOOK_HMAC_SECRET=

# =============================================================================
# Storage Paths
# =============================================================================
STORAGE_PATH=/data/storage
TEMPLATE_PATH=/data/templates
OUTPUT_PATH=/data/output
COLLAB_STORAGE_PATH=/data/collaboration

# Linode E3 Object Storage for server-side RFP files.
# E3 does not support browser CORS; route uploads through the app server.
LINODE_E3_ENDPOINT=https://gb-lon-1.linodeobjects.com
LINODE_E3_REGION=gb-lon-1
LINODE_E3_BUCKET=mansa
LINODE_E3_PREFIX=rfp
LINODE_E3_ACCESS_KEY_ID=
LINODE_E3_SECRET_ACCESS_KEY=

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
