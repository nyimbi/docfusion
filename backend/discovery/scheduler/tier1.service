# DocuFusion Scraper - Tier 1 Service (High Priority Sources)
# Executes scrapers for critical sources: UNGM, AfDB, World Bank, etc.
#
# This service is triggered by tier1.timer (every 6 hours)
#
# CONFIGURATION:
#   - Adjust User/Group to match your deployment user
#   - Adjust WorkingDirectory to your installation path
#   - EnvironmentFile can be used to set DATABASE_URL, API keys, etc.

[Unit]
Description=DocuFusion Scraper Tier 1 Service
Documentation=https://github.com/docfusion/docfusion
After=network.target postgresql.service
Wants=postgresql.service

[Service]
# Service type: oneshot for scheduled execution
Type=oneshot

# Run as the application user (adjust as needed)
User=azureuser
Group=azureuser

# Working directory - adjust to your installation path
WorkingDirectory=/home/azureuser/docfusion/backend

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="LOG_LEVEL=INFO"
# EnvironmentFile=/etc/docfusion/environment (optional, for secrets)

# Execute tier 1 scrapers
ExecStart=/usr/bin/python3 -m backend.discovery.scheduler.scraper_runner --tier tier1

# Resource limits - Tier 1 runs critical sources, needs more resources
MemoryMax=2G
MemoryHigh=1800M
CPUQuota=100%

# Timeout: 30 minutes (critical sources should complete quickly)
TimeoutSec=1800
TimeoutStartSec=1800

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=docfusion-scraper-tier1

# Retry configuration (no restart for oneshot, but track failures)
Restart=no

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/azureuser/docfusion

[Install]
WantedBy=multi-user.target