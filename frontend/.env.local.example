# DocFusion Frontend Environment Variables
# Copy this file to .env.local and update with your values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Real-time collaboration (Pusher/Soketi)
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Self-hosted Soketi (optional - for local development)
NEXT_PUBLIC_SOKETI_HOST=localhost
NEXT_PUBLIC_SOKETI_PORT=6001

# Feature flags
NEXT_PUBLIC_ENABLE_COLLABORATION=true
NEXT_PUBLIC_ENABLE_AI_COMMANDS=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Sentry error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
