# DocuFusion Frontend - Development Environment Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit actual secrets to version control

# =============================================================================
# Authentication
# =============================================================================
# NextAuth/Auth.js secret for session encryption (REQUIRED)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here
NEXTAUTH_SECRET=your-auth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Keycloak SSO
KEYCLOAK_ISSUER="https://your-keycloak-host/realms/your-realm"
KEYCLOAK_CLIENT_ID="docfusion"
KEYCLOAK_CLIENT_SECRET="your-keycloak-client-secret"

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://your-db-user:your-db-password@localhost:5432/docfusion"

# =============================================================================
# Azure OpenAI Configuration (for AI features)
# =============================================================================
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# Real-time Collaboration (Soketi/Pusher)
# =============================================================================
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key-here
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_HOST=localhost
NEXT_PUBLIC_PUSHER_PORT=6001
PUSHER_APP_SECRET=your-pusher-secret-here

# =============================================================================
# PJS Infrastructure Services (optional)
# =============================================================================
# SearXNG Metasearch
SEARXNG_URL="http://your-searxng-host:8888"

# Firecrawl Web Scraping
FIRECRAWL_URL="http://your-firecrawl-host:3002"

# LiteLLM AI Gateway
LITELLM_URL="http://your-litellm-host:4000"
LITELLM_KEY="your-litellm-key-here"

# Linode E3 Object Storage for server-side RFP uploads.
# Do not expose these as NEXT_PUBLIC_* values; E3 does not support browser CORS.
LINODE_E3_ENDPOINT=https://mansa.gb-lon-1.linodeobjects.com
LINODE_E3_REGION=gb-lon-1
LINODE_E3_BUCKET=your-rfp-bucket
LINODE_E3_PREFIX=rfp
LINODE_E3_ACCESS_KEY_ID=your-linode-e3-access-key-id
LINODE_E3_SECRET_ACCESS_KEY=your-linode-e3-secret-access-key

# Temporal Workflow Engine
TEMPORAL_URL="your-temporal-host:7233"

# SpiceDB/Authzed authorization
SPICEDB_ENDPOINT="your-spicedb-host:50051"
SPICEDB_KEY="your-spicedb-token"
# Only for local development with localhost/127.0.0.1 endpoints.
SPICEDB_ALLOW_INSECURE_LOCALHOST=false

# =============================================================================
# Email Configuration (optional)
# =============================================================================
# PJS Stalwart mail server. Use submission with STARTTLS.
SMTP_HOST=mail.lindela.io
SMTP_PORT=587
SMTP_USER=your-stalwart-username
SMTP_PASSWORD=your-stalwart-password
SMTP_USE_TLS=true

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_COLLABORATION=true
NEXT_PUBLIC_ENABLE_AI_COMMANDS=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# =============================================================================
# Debug Mode
# =============================================================================
NEXT_PUBLIC_DEBUG=true
