{
	"include": ["src"],
	"extraPaths": ["src"],
	"pythonVersion": "3.12",
	"typeCheckingMode": "basic",
	"useLibraryCodeForTypes": true,
	"reportMissingImports": "error",
	"reportMissingTypeStubs": "none",
	"exclude": [
		"**/__pycache__",
		"**/.venv",
		"**/node_modules",
		"**/tests/fixtures",
		"artifacts",
		"data"
	]
}
